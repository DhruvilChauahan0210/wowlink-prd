# Copy to .env.local and fill in. .env.local is never committed.

# The public address, for share previews, canonical links, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opens WowLink's admin page (/admin): reports, taking invitations down, the app's numbers.
# On a live site it needs at least 24 characters (make one with: openssl rand -hex 24);
# with `npm run dev` any key works. Leave it empty and the admin doesn't exist.
WOWLINK_ADMIN_KEY=

# Where the data lives. Empty: a JSON file in .data/ (fine on your own computer). Set: Postgres on Supabase.
# Supabase: Connect (top of the project) > Transaction pooler, port 6543; put your database password in it.
# Then run `npm run db:migrate` once to set up the tables.
DATABASE_URL=

# Accounts (Supabase Auth): the project's address and publishable key, both public by design.
# Supabase: Project settings > API keys. Leave empty for no accounts (anyone can publish).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
