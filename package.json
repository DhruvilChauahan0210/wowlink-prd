{
  "name": "wowlink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "test:pg": "WOWLINK_TEST_DB=pg playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/db-import.mjs",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lenis": "1.3.11",
    "next": "^15.5.4",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.18.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
